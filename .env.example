# BhashaShield AI Environment Variables

# Backend
PROJECT_NAME="BhashaShield AI"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
DATABASE_URL="sqlite+aiosqlite:///./bhashashield.db"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Research Configuration
DEMO_MODE=true
ALLOW_MOCK_ADAPTER=true
DEFAULT_MODEL_NAME="mock-research-adapter"
GUARD_CONFIDENCE_THRESHOLD=0.70

# Frontend
VITE_API_URL="http://localhost:8000"
